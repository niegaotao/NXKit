use_frameworks!

minimum_ios_version = '15.0'
platform :ios, minimum_ios_version

target 'NXKit_Example' do
  pod 'NXKit', :path => '../'
end

#https://cloud.tencent.com/developer/article/2105277
#解决Xcode 14 needs selected Development Team for Pod Bundles
post_install do |installer|
  installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
          config.build_settings['CODE_SIGN_IDENTITY'] = ''
      end
  end
end
